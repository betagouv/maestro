{
  "name": "Maestro",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betagouv/maestro.git"
  },
  "workspaces": [
    "shared",
    "server",
    "frontend"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "start-local": "run-p server-local frontend-local",
    "server-local": "npm run dev -w server",
    "frontend-local": "npm run dev -w frontend",
    "start": "npm run start -w server",
    "scalingo-postbuild": "npm run --workspaces --if-present scalingo-postbuild",
    "lint": "biome check",
    "knip": "knip"
  },
  "overrides": {
    "@types/node": "$@types/node"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.5",
    "@types/ssh2-sftp-client": "^9.0.6",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "npm-run-all2": "^9.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lodash-es": "^4.18.1",
    "tsafe": "^1.8.12",
    "zod": "^4.6.7"
  },
  "release": {
    "branches": [
      "prod",
      {
        "name": "prod",
        "prerelease": false
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github",
      "./.github/semanticReleaseTchap.mjs"
    ]
  }
}
