{
  "env": {
    "APPLICATION_HOST": {
      "generator": "url",
      "template": "%URL%"
    },
    "VITE_PUBLIC_URL": {
      "generator": "url",
      "template": "%URL%"
    },
    "VITE_API_URL": {
      "generator": "url",
      "template": "%URL%"
    },
    "VITE_REVIEW_APP": {
      "value": "true"
    },
    "DATABASE_KYSELY_POOL_MAX": {
      "value": "15"
    },
    "DATABASE_KNEX_POOL_MAX": {
      "value": "5"
    }
  },
  "scripts": {
    "first-deploy": "npm ci && npm run -w server migrate-latest && npm run seed:departments -w server && npm run -w server seed"
  }
}
